                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                    ]
                ])
                input[1] = Channel.of([])
                input[2] = []
                input[3] = Channel.of([
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true)
                ])
                input[4] = 'fastp'
                input[5] = true
                input[6] = false
                input[7] = false
                input[8] = 1
                input[9] = false
                input[10] = false
                input[11] = false
                input[12] = 1
                input[13] = 'read'
                input[14] = false
                input[15] = false
                input[16] = false
                input[17] = 'bbduk'
                input[18] = true
                input[19] = true
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.mqc },
                { assert snapshot(
                    workflow.out.reads,
                    workflow.out.reads_trimmed,
                    workflow.out.reads_decomplexified,
                    workflow.out.low_reads_mqc,
                ).match() }
            )
        }
    }

    //
    // Test 6: With decomplexification using PRINSEQ
    //
    test("sarscov2 paired-end [fastq] - prinseq") {

        when {
            params {
                arguments_fastp           = ''
                arguments_trimmomatic     = ''
            }
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:false, sample:'test' ],
                    [
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                    ]
                ])
                input[1] = Channel.of([])
                input[2] = []
                input[3] = Channel.of([])
                input[4] = 'fastp'
                input[5] = true
                input[6] = false
                input[7] = false
                input[8] = 1
                input[9] = false
                input[10] = false
                input[11] = false
                input[12] = 1
                input[13] = 'read'
                input[14] = false
                input[15] = false
                input[16] = false
                input[17] = 'prinseq'
                input[18] = true
                input[19] = true
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success                  },
                { assert workflow.out.mqc                  },
                { assert workflow.out.reads                }, // prinseq not determinstic output could use nft-fastq later
                { assert workflow.out.reads_decomplexified }, // prinseq not determinstic output could use nft-fastq later
                { assert snapshot(
                    workflow.out.reads_trimmed,
                    workflow.out.low_reads_mqc,
                ).match() }
            )
        }
    }

    //
    // Test 7: With host removal using Kraken2
    //
    test("sarscov2 paired-end [fastq] - host_removal") {

        when {
            params {
                arguments_fastp           = ''
                arguments_trimmomatic     = ''
            }
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:false, sample:'test' ],
                    [
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                    ]
                ])
                input[1] = KRAKEN2_HOST_DB_UNTAR.out.untar.map{ meta, db -> db }
                input[2] = []
                input[3] = Channel.of([])
                input[4] = 'fastp'
                input[5] = true
                input[6] = false
                input[7] = false
                input[8] = 1
                input[9] = false
                input[10] = false
                input[11] = false
                input[12] = 1
                input[13] = 'read'
                input[14] = false
                input[15] = false
                input[16] = true
                input[17] = 'bbduk'
                input[18] = false
                input[19] = true
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.mqc },
                { assert snapshot(
                    workflow.out.reads,
                    workflow.out.reads_trimmed,
                    workflow.out.reads_decomplexified,
                    workflow.out.low_reads_mqc,
                ).match() }
