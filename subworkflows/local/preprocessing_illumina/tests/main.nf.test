    //
    // Test 9: Low read count handling
    //
    test("sarscov2 paired-end [fastq] - min_trimmed_reads_fail") {

        when {
            params {
                arguments_fastp           = ''
                arguments_trimmomatic     = ''
            }
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:false, sample:'test' ],
                    [
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                    ]
                ])
                input[1] = Channel.of([])
                input[2] = []
                input[3] = Channel.of([])
                input[4] = 'fastp'
                input[5] = true
                input[6] = false
                input[7] = false
                input[8] = 1
                input[9] = false
                input[10] = false
                input[11] = false
                input[12] = 100000
                input[13] = 'read'
                input[14] = false
                input[15] = false
                input[16] = true
                input[17] = 'bbduk'
                input[18] = true
                input[19] = true
                """
