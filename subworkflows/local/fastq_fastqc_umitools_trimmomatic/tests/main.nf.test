nextflow_workflow {

    name "Test Workflow FASTQ_FASTQC_UMITOOLS_TRIMMOMATIC"
    script "../main.nf"
    workflow "FASTQ_FASTQC_UMITOOLS_TRIMMOMATIC"
    config './nextflow.config'

    tag "subworkflows"
    tag "subworkflows_nfcore"
    tag "subworkflows/fastq_fastqc_umitools_trimmomatic"
    tag "fastq_fastqc_umitools_trimmomatic"
    tag "fastqc"
    tag "umitools/extract"
    tag "trimmomatic"


    test("sarscov2 paired-end [fastq]") {

        when {
            params {
                trimmomatic_args = "ILLUMINACLIP:TruSeq3-PE:2:30:10"
            }
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:false ], // meta map
                    [
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                    ]
                ])
                input[1] = false
                input[2] = false
                input[3] = false
                input[4] = 1
                input[5] = false
                input[6] = 1
                """
            }
        }

        then {
            assert workflow.success
            assertAll(
                { assert workflow.out.fastqc_raw_html },
                { assert workflow.out.fastqc_raw_zip },
                { assert workflow.out.fastqc_trim_html },
                { assert workflow.out.fastqc_trim_zip },
                { assert workflow.out.trim_summ },
                { assert workflow.out.trim_log },
                { assert snapshot(
                        workflow.out.reads,
                        workflow.out.trim_read_count,
                        workflow.out.trim_reads_fail,
                        workflow.out.trim_reads_merged,
                        workflow.out.umi_log,
                    ).match()
                }
            )
        }
    }

    test("sarscov2 single-end [fastq]") {

        when {
            params {
                trimmomatic_args = "ILLUMINACLIP:TruSeq3-SE:2:30:10"
            }
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:true ], // meta map
                    [file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true)],
                ])
                input[1] = false
                input[2] = false
                input[3] = false
                input[4] = 1
                input[5] = false
                input[6] = 1
                """
            }
        }

        then {
            assert workflow.success
            assertAll(
                { assert workflow.out.fastqc_raw_html },
                { assert workflow.out.fastqc_raw_zip },
                { assert workflow.out.trim_summ },
                { assert workflow.out.trim_log },
                { assert snapshot(
                        workflow.out.reads,
                        workflow.out.trim_read_count,
                        workflow.out.trim_reads_fail,
                        workflow.out.trim_reads_merged,
                        workflow.out.umi_log,
                    ).match()
                }
            )
        }
    }

    test("sarscov2 paired-end [fastq] | skip_fastqc") {

        when {
            params {
                trimmomatic_args = "ILLUMINACLIP:TruSeq3-PE:2:30:10"
            }
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end: false ], // meta map
                    [
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                    ]
                ])
                input[1] = true
                input[2] = false
                input[3] = false
                input[4] = 1
                input[5] = false
                input[6] = 1
                """
            }
        }

        then {
            assert workflow.success
            assertAll(
                { assert workflow.out.trim_summ },
                { assert workflow.out.trim_log },
                { assert !workflow.out.fastqc_raw_html },
                { assert !workflow.out.fastqc_raw_zip },
                { assert !workflow.out.fastqc_trim_html },
                { assert !workflow.out.fastqc_trim_zip },
                { assert snapshot(
                        workflow.out.reads,
                        workflow.out.trim_read_count,
                        workflow.out.trim_unpaired_reads,
                        workflow.out.umi_log,
                    ).match()
                }
            )
        }
    }

