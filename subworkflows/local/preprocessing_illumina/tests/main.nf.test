    //
    // Test 10: Default trimmomatic workflow - stub
    //
    test("sarscov2 paired-end [fastq] - trimmomatic - stub") {
        options '-stub-run'

        when {
            params {
                arguments_trimmomatic     = 'ILLUMINACLIP:TruSeq3-PE:2:30:10'
                arguments_fastp           = ''
            }
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:false, sample:'test' ],
                    [
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
